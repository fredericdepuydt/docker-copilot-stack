#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
LAUNCHER="$SCRIPT_DIR/copilot"
INSTALL_DIR=${COPILOT_INSTALL_DIR:-"$HOME/.local/bin"}
START_MARKER="# >>> docker copilot launcher >>>"
END_MARKER="# <<< docker copilot launcher <<<"

if [[ ! -f "$LAUNCHER" ]]; then
    echo "Expected launcher not found: $LAUNCHER" >&2
    exit 1
fi

mkdir -p -- "$INSTALL_DIR"
INSTALL_DIR=$(cd -- "$INSTALL_DIR" && pwd -P)
TARGET="$INSTALL_DIR/copilot"
chmod +x -- "$LAUNCHER"

if [[ -e "$TARGET" && ! -L "$TARGET" ]]; then
    echo "Refusing to replace existing non-symlink: $TARGET" >&2
    exit 1
fi

ln -sfn -- "$LAUNCHER" "$TARGET"

if [[ -n ${COPILOT_PROFILE:-} ]]; then
    PROFILE=$COPILOT_PROFILE
    PROFILE_KIND=posix
else
    case ${SHELL:-} in
        */bash)
            PROFILE="$HOME/.bashrc"
            PROFILE_KIND=posix
            ;;
        */zsh)
            PROFILE="$HOME/.zshrc"
            PROFILE_KIND=posix
            ;;
        */fish)
            PROFILE="$HOME/.config/fish/config.fish"
            PROFILE_KIND=fish
            ;;
        *)
            PROFILE="$HOME/.profile"
            PROFILE_KIND=posix
            ;;
    esac
fi

profile_has_start=0
profile_has_end=0
if [[ -f "$PROFILE" ]]; then
    if grep -Fqx "$START_MARKER" "$PROFILE"; then
        profile_has_start=1
    fi
    if grep -Fqx "$END_MARKER" "$PROFILE"; then
        profile_has_end=1
    fi
fi

if [[ $profile_has_start -ne $profile_has_end ]]; then
    echo "Incomplete Copilot launcher block in $PROFILE; remove it and rerun install." >&2
    exit 1
fi

profile_changed=0
if [[ $profile_has_start -eq 1 || ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    mkdir -p -- "$(dirname -- "$PROFILE")"
    touch -- "$PROFILE"

    escaped_install_dir=${INSTALL_DIR//\'/\'\"\'\"\'}
    if [[ "$PROFILE_KIND" == fish ]]; then
        path_line="fish_add_path '$escaped_install_dir'"
    else
        path_line="export PATH=\"\$PATH\":'$escaped_install_dir'"
    fi

    temporary_profile=$(mktemp "${PROFILE}.copilot.XXXXXX")
    trap 'rm -f -- "$temporary_profile"' EXIT

    if [[ $profile_has_start -eq 1 ]]; then
        awk -v start="$START_MARKER" -v end="$END_MARKER" '
            $0 == start { skip = 1; next }
            $0 == end { skip = 0; next }
            !skip { print }
        ' "$PROFILE" >"$temporary_profile"
    else
        cp -- "$PROFILE" "$temporary_profile"
    fi

    if [[ -s "$temporary_profile" ]] && [[ $(tail -c 1 "$temporary_profile" | wc -l) -eq 0 ]]; then
        printf '\n' >>"$temporary_profile"
    fi
    printf '%s\n%s\n%s\n' "$START_MARKER" "$path_line" "$END_MARKER" >>"$temporary_profile"
    cat "$temporary_profile" >"$PROFILE"
    rm -f -- "$temporary_profile"
    trap - EXIT
    profile_changed=1
fi

echo "Installed copilot launcher at $TARGET"
if [[ $profile_changed -eq 1 ]]; then
    echo "Updated PATH in $PROFILE"
    echo "Run 'source \"$PROFILE\"' (or restart your shell), then use: copilot"
else
    echo "Use: copilot"
fi
