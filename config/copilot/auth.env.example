# This example is documentation only and is never loaded automatically.
# GitHub credentials are created by `copilot login` in central config/copilot/config.json.
COPILOT_STACK_AUTH_MODE=hybrid
COPILOT_PROVIDER_TYPE=openai
COPILOT_PROVIDER_BASE_URL=https://litellm.example.com/v1
COPILOT_PROVIDER_API_KEY=
COPILOT_MODEL=configured-model-alias
COPILOT_OFFLINE=false
